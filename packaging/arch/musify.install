print_musify_post_install() {
  cat <<'EOF2'
Musify setup:

  Launch it, press Sign in with Spotify, and approve in the browser.
  Playing music on this computer is one more one-time approval from the
  device menu (the speaker icon). A free account streams through YouTube,
  so install yt-dlp and mpv; a Premium account needs no extra tools.

  Closing the window keeps the music playing in the system tray; quit from
  the tray menu or with Ctrl+Q.

Docs: https://github.com/msedge-projects/spotifast-yt
EOF2
}

post_install() {
  print_musify_post_install
}

post_upgrade() {
  print_musify_post_install
}
